# S1 CrewAI — lee el backlog vía MCP Proyectos y, al final, abre un PR
# (con aprobación humana) en <GITHUB_OWNER>/<PR_REPO>.

# ── LLM — GitHub Copilot ────────────────────────────────────────────
COPILOT_MODEL=claude-sonnet-5.5
COPILOT_REASONING_EFFORT=high
# true usa la sesión guardada del CLI; false exige un token explícito.
COPILOT_USE_LOGGED_IN_USER=true
# Límite total por paso y límite sin actividad del modelo (segundos).
COPILOT_TIMEOUT=900
COPILOT_IDLE_TIMEOUT=240

# Copiar este archivo como .env. NUNCA commitear .env.

# ── MCP Proyectos — backlog de GitHub Projects (puerto 8081) ─────
PROJECTS_MCP_URL=http://localhost:8081
PROJECTS_MCP_API_KEY=prj-xxxxxxxxxxxxxxxxxxxx

# Owner y repo desde donde el MCP resuelve los Issues del backlog:
# TU Project ReqFlow (Días 2-3), no el del trainer
GITHUB_OWNER=<OWNER>            # tu owner: el mismo de los Días 1-3
GITHUB_REPO=wallet-app-g6

# Solo el grupo de siete activa Datos y persistencia.
CREWAI_INCLUDE_DATA=false

# Origen del feature: "mcp" usa el backlog de GitHub Projects vía MCP local (github-local, :8081); "openspec" lee openspec/changes/.
FEATURE_SOURCE=mcp

# ── Pull request final ─────────────────────────────────────────────
# Repo destino: <GITHUB_OWNER>/<PR_REPO>. Usa la sesión de `gh`; si no tienes
# permiso de push, publica la rama en tu fork. PR_BASE_BRANCH vacío = rama por defecto.
PR_REPO=wallet-app-g6
PR_BASE_BRANCH=
